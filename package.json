{
  "name": "openmap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "licences": "node scripts/check-licences.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run depcruise && npm run licences && npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@fontsource-variable/libre-baskerville": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "clsx": "2.1.1",
    "dexie": "4.4.6",
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "dependency-cruiser": "18.4.0",
    "fake-indexeddb": "6.2.5",
    "license-checker-rseidelsohn": "5.0.1",
    "oxlint": "1.86.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
