{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{21}$"
    },
    "seed": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{21}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^\\P{Cc}{1,120}$"
        },
        {
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      ]
    },
    "mapLocale": {
      "type": "string",
      "enum": [
        "fr",
        "en"
      ]
    },
    "outputFormat": {
      "type": "string",
      "enum": [
        "16:9",
        "9:16",
        "1:1"
      ]
    },
    "referenceDate": {
      "type": "object",
      "properties": {
        "year": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 2100
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      },
      "required": [
        "year"
      ],
      "additionalProperties": false
    },
    "map": {
      "type": "object",
      "properties": {
        "basemap": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "parchment",
                "sombre",
                "clair",
                "relief"
              ]
            },
            "adjustments": {
              "type": "object",
              "properties": {
                "brightness": {
                  "type": "integer",
                  "minimum": -50,
                  "maximum": 50
                },
                "saturation": {
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 50
                },
                "tintColor": {
                  "type": "string",
                  "pattern": "^#[0-9A-F]{6}$"
                },
                "tintIntensity": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "adjustments"
          ],
          "additionalProperties": false
        },
        "members": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "not": {}
          }
        }
      },
      "required": [
        "basemap",
        "members"
      ],
      "additionalProperties": false
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{21}$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "layers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{21}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "territories",
              "arrows",
              "tokens",
              "texts",
              "images"
            ]
          },
          "hidden": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "hidden",
          "locked"
        ],
        "additionalProperties": false
      }
    },
    "factions": {
      "type": "array",
      "items": {
        "not": {}
      }
    },
    "pins": {
      "type": "object",
      "properties": {
        "geo": {
          "type": "object",
          "properties": {
            "dataset": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            }
          },
          "required": [
            "dataset",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "geo"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "seed",
    "revision",
    "name",
    "mapLocale",
    "outputFormat",
    "referenceDate",
    "map",
    "steps",
    "layers",
    "factions",
    "pins"
  ],
  "additionalProperties": false
}
